# Keep large/generated/noisy files out of Claude's context.

# Dependencies & build output
node_modules/
frontend/dist/
frontend/node_modules/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Lockfiles (huge, low signal)
frontend/package-lock.json
package-lock.json

# Local data / secrets / artifacts
*.db
.vapid.json
.env
web/uploads/
snapshots/

# Test / tooling output
frontend/test-results/
frontend/playwright-report/
frontend/shoot.mjs
/tmp/shot_*.png

# Alembic autogenerated migrations (schema churn; keep env.py)
app/alembic/versions/

# Logs & OS
*.log
.DS_Store
